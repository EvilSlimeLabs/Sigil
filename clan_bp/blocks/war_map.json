{
  "format_version": "1.21.40",
  "minecraft:block": {
    "description": {
      "identifier": "clan:war_map",
      "menu_category": {
        "category": "items"
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        },
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      }
    },
    "components": {
      "minecraft:display_name": "War Map",
      "minecraft:geometry": "geometry.clan_war_map_floor",
      "minecraft:material_instances": {
        "*": {
          "texture": "clan_war_map",
          "render_method": "alpha_test",
          "face_dimming": false
        }
      },
      "minecraft:collision_box": false,
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 1, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.4
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      "minecraft:light_dampening": 0,
      "minecraft:tick": {
        "interval_range": [20, 20],
        "looping": true
      },
      "minecraft:custom_components": ["clan:war_map"]
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face') == 'north'",
        "components": {
          "minecraft:geometry": "geometry.clan_war_map_north",
          "minecraft:selection_box": {
            "origin": [-8, 0, 7],
            "size": [16, 16, 1]
          },
          "minecraft:collision_box": false
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:geometry": "geometry.clan_war_map_south",
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 16, 1]
          },
          "minecraft:collision_box": false
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:geometry": "geometry.clan_war_map_west",
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [1, 16, 16]
          },
          "minecraft:collision_box": false
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'east'",
        "components": {
          "minecraft:geometry": "geometry.clan_war_map_east",
          "minecraft:selection_box": {
            "origin": [7, 0, -8],
            "size": [1, 16, 16]
          },
          "minecraft:collision_box": false
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'up' && q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'up' && q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'up' && q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'up' && q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      }
    ]
  }
}
